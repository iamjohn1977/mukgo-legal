<?xml version="1.0" encoding="utf-8"?>
<!-- The app keeps the reader's name/email and journal entries in WebView
     localStorage. None of it should leave the device, so both cloud backup and
     device-to-device transfer are disabled. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
